# Ignore everything
*

# Allow Python files
!*.py
!dashboard/
!dashboard/*.py

# Allow Excel files
!*.xlsx
!*.csv

# Allow PDF files
!*.pdf

# Allow README files
!README.md

# Allow deployment/runtime manifests
!requirements.txt
!*.geojson
!vercel.json

# Allow landing page
!landing/
!landing/*

# Allow Streamlit theme config
!.streamlit/
!.streamlit/config.toml

# Allow .gitignore file
!.gitignore
